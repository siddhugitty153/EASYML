# ============================================================
# EasyML — Environment Variables
# ============================================================
# Copy this file to .env and fill in production values:
#   cp .env.example .env
# ============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=easyml
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=easyml
POSTGRES_PORT=5432

# Full connection string (used by app.py / database.py)
DATABASE_URL=postgresql://easyml:change_me_in_production@db:5432/easyml

# ── Redis / Celery ────────────────────────────────────────────
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Flask ─────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=production
# Set to 'development' for debug mode (do NOT use in production)
# FLASK_ENV=development

# ── Gunicorn ──────────────────────────────────────────────────
# Number of Gunicorn workers (2 × CPU cores + 1 is a good default)
GUNICORN_WORKERS=4
# Request timeout in seconds (increase for large dataset uploads)
GUNICORN_TIMEOUT=120

# ── Web Server ────────────────────────────────────────────────
WEB_PORT=5000

# ── Gemini AI (Chatbot / Explainer) ───────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Application ───────────────────────────────────────────────
# Max upload size in bytes (default: 100 MB)
MAX_CONTENT_LENGTH=104857600
